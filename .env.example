# =============================================================================
# Homelab — environment variables injected into Ansible
# -----------------------------------------------------------------------------
# Local: copy to .env (gitignored), fill in, then run `make deploy`.
# CI (later): same names, defined as GitHub Actions secrets.
# Ansible reads them using lookup('ansible.builtin.env', 'NAME', default=Undefined).
# =============================================================================

# --- Target / access ---------------------------------------------------------
# Proxmox host (e.g. https://pve.example.com:8006)
PROXMOX_HOST=
PROXMOX_NODE=pve
# Proxmox API token (Datacenter > Permissions > API Tokens)
PROXMOX_API_USER=ansible@pve
PROXMOX_API_TOKEN_ID=ansible
PROXMOX_API_TOKEN_SECRET=
# SSH key used by Ansible to connect to the VMs
ANSIBLE_SSH_PRIVATE_KEY_FILE=~/.ssh/homelab_ed25519
ANSIBLE_SSH_USER=ansible

# --- Securo ------------------------------------------------------------------
# Required
SECURO_SECRET_KEY=
# Public URL (required for passkeys and OAuth redirects)
SECURO_FRONTEND_URL=https://securo.example.com
SECURO_WEBAUTHN_RP_ID=securo.example.com
SECURO_WEBAUTHN_RP_NAME=Securo
SECURO_FRONTEND_PORT=3000
SECURO_BACKEND_PORT=
SECURO_TZ=Europe/Paris
SECURO_TESOURO_DIRETO_ENABLED=false

# --- Open Exchange Rates API KEY----------------------------------------------
OPENEXCHANGERATES_APP_ID=

# --- Securo: Enable Banking sync (European banks) ----------------------------
ENABLE_BANKING_APP_ID=
# LOCAL path to the PEM key; Ansible copies it to
# /app/secrets/enable_banking_private.pem on the VM
ENABLE_BANKING_PRIVATE_KEY_LOCAL_PATH=~/.secrets/enable_banking_private.pem
# Must exactly match an Enable Banking app redirect URL (HTTPS)
ENABLE_BANKING_OAUTH_REDIRECT_URI=https://securo.example.com/oauth/callback


# --- Securo : connexion OIDC (optionnel) -------------------------------------
SECURO_OIDC_ENABLED=false
SECURO_OIDC_PROVIDER_NAME=
SECURO_OIDC_DISCOVERY_URL=
SECURO_OIDC_CLIENT_ID=securo
SECURO_OIDC_CLIENT_SECRET=

# --- Cloudflared -------------------------------------------------------------
CLOUDFLARED_TUNNEL_TOKEN=

# --- Pi-hole -----------------------------------------------------------------
PIHOLE_WEBPASSWORD=
PIHOLE_TZ=Europe/Paris
